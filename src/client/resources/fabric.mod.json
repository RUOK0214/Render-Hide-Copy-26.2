{
  "schemaVersion": 1,
  "id": "renderhide",
  "version": "${version}",
  "name": "Render Hide",
  "description": "Hide blocks and entities in selected regions or adjust their opacity. Filtered types remain visible. World blocks and redstone behavior are unchanged.\n\nH: Settings · F9/F10: Select corners · F7: Save region · F8: Toggle all\n\nKnown limitations: Item frames and some touching faces may render incorrectly. Region settings are shared across worlds.",
  "authors": [
    "RUOK0214"
  ],
  "contact": {
    "homepage": "https://discord.gg/95secUdgMK",
    "sources": "https://github.com/RUOK0214/Render-Hide-Copy-26.2",
    "issues": "https://github.com/RUOK0214/Render-Hide-Copy-26.2/issues"
  },
  "license": "MIT",
  "icon": "assets/renderhide/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.ruok0214.renderhide.RenderHideClient"
    ]
  },
  "mixins": [
    {
      "config": "renderhide.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "=26.2",
    "java": ">=25",
    "fabric-api": ">=0.158.0+26.2"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.discord": "https://discord.gg/95secUdgMK"
      }
    }
  }
}
